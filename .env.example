# ==============================================================================
# AI-Enabled SaaS Subscription & Analytics Platform - Environment Configuration
# ==============================================================================
# Copy this file to .env before starting the platform:
#   cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ==============================================================================
# Database Configuration (PostgreSQL 16)
# ==============================================================================
# By default, use PostgreSQL running locally or via Docker Compose:
#   docker compose up -d
DB_DIALECT=postgres
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/saas_platform
DB_HOST=localhost
DB_PORT=5432
DB_NAME=saas_platform
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_LOGGING=false

# Optional: For instant zero-dependency local evaluation without Docker/PostgreSQL:
# Set DB_DIALECT=sqlite and SQLITE_STORAGE=storage/saas_platform.sqlite
# DB_DIALECT=sqlite
# SQLITE_STORAGE=storage/saas_platform.sqlite

# ==============================================================================
# Redis Configuration (Redis 7)
# ==============================================================================
# Connect to Redis running locally or via Docker Compose:
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional: For instant zero-dependency local evaluation without Docker/Redis:
# Set USE_MOCK_REDIS=true
# USE_MOCK_REDIS=false

# ==============================================================================
# Stripe Configuration (Free Test Mode)
# ==============================================================================
# 1. Sign up for a free developer account at: https://stripe.com
# 2. Toggle "Test mode" in the top-right of your Stripe Dashboard.
# 3. Go to "Developers" > "API keys" and copy your "Secret key" (starts with sk_test_...)
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_test_secret_key

# 4. For Webhook Testing:
#    Install the Stripe CLI (https://stripe.com/docs/stripe-cli)
#    Run: stripe listen --forward-to localhost:3000/api/webhooks/stripe
#    Copy the signing secret printed in terminal (starts with whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_webhook_secret

# ==============================================================================
# Nodemailer / Mailtrap Configuration (Free Sandbox)
# ==============================================================================
# 1. Sign up for a free developer account at: https://mailtrap.io
# 2. Go to "Email Testing" > "Inboxes" > Select or create an inbox.
# 3. In "Show Credentials", select "Nodemailer" from the integration dropdown.
# 4. Copy your credentials below:
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=replace_with_your_mailtrap_user
SMTP_PASS=replace_with_your_mailtrap_password
EMAIL_FROM=no-reply@saasplatform.local

# ==============================================================================
# Jobs Configuration
# ==============================================================================
# Cron schedule for checking expiring subscriptions (default: daily at 9:00 AM)
REMINDER_CRON_SCHEDULE=0 9 * * *
